PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/seafood
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-strong-password
CLIENT_URL=http://localhost:3000
NODE_ENV=development
# Hostinger email settings (do not commit the real password in .env)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@seafoodwala.in
SMTP_PASSWORD=add-your-hostinger-email-password-here
SMTP_FROM=Seafood Wala Website <info@seafoodwala.in>
CONTACT_RECIPIENT=info@seafoodwala.in
